---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DateMeta from "../components/DateMeta.astro";
import ViewCounter from "../components/ViewCounter.astro";
import { SITE_TITLE } from "../consts";
import "../styles/layout.css";
import type { ImageMetadata } from "astro";
interface Props {
	title: string;
	description?: string;
	breadcrumbTitle?: string;
	pubDate?: Date;
	updatedDate?: Date;
	date?: Date;
	dateLabel?: string;
	dateDisplay?: string;
	dateLabels?: { published?: string; updated?: string; page?: string };
	image?: ImageMetadata;
	slug?: string;
	workerUrl?: string;
	headings?: { depth: number; slug: string; text: string }[];
	minutes?: number;
	category?: string;
	tags?: string[];
	section?: { href: string; label: string };
}
const {
	title,
	description = "",
	pubDate,
	updatedDate,
	date,
	dateLabel,
	dateDisplay,
	dateLabels,
	image,
	slug,
	workerUrl,
	headings = [],
	minutes,
	category,
	tags = [],
	section,
} = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const published = pubDate ?? date;
---

<!doctype html>
<html lang="en">
	<head
		><BaseHead
			title={`${title} | ${SITE_TITLE}`}
			description={description}
			image={image}
			type={pubDate ? "article" : "website"}
			pubDate={pubDate}
			updatedDate={updatedDate}
		/>
		{
			pubDate && (
				<script
					type="application/ld+json"
					set:html={JSON.stringify({
						"@context": "https://schema.org",
						"@type": "BlogPosting",
						headline: title,
						description,
						datePublished: pubDate.toISOString(),
						dateModified: (updatedDate ?? pubDate).toISOString(),
						author: { "@type": "Person", name: SITE_TITLE, url: Astro.site },
						mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
					}).replace(/</g, "\\u003c")}
				/>
			)
		}
	</head><body
		><Header />
		<main
			id="main-content"
			tabindex="-1"
			class:list={["article-layout", { "has-toc": toc.length > 0 }]}
		>
			<div class="reading-column">
				<header class="post-header">
					{
						section && (
							<a class="section-back" href={section.href}>
								{section.label}
							</a>
						)
					}
					{category && <p class="eyebrow">{category}</p>}
					<h1 class="post-title">{title}</h1>
					{description && <p class="article-deck">{description}</p>}
					<div class="meta post-dates">
						{
							published && (
								<DateMeta
									date={published}
									display={dateDisplay}
									label={
										pubDate
											? dateLabels?.published
											: (dateLabels?.page ?? dateLabel)
									}
									as="span"
								/>
							)
						}
						{
							updatedDate && (
								<DateMeta
									date={updatedDate}
									label={dateLabels?.updated ?? "Updated"}
									as="span"
								/>
							)
						}
						{minutes && <span>{minutes} min read</span>}
						{
							slug && workerUrl && (
								<ViewCounter slug={slug} workerUrl={workerUrl} />
							)
						}
					</div>
					{
						tags.length > 0 && (
							<div class="tags">
								{tags.map((tag) => (
									<a
										class="tag"
										href={`/writing/?tag=${encodeURIComponent(tag)}`}
									>
										{tag}
									</a>
								))}
							</div>
						)
					}
				</header>
				{
					toc.length > 0 && (
						<details class="mobile-toc">
							<>
								<summary>On this page</summary>
								<ol>
									{toc.map((h) => (
										<li class:list={[{ subheading: h.depth === 3 }]}>
											<a href={`#${h.slug}`}>{h.text}</a>
										</li>
									))}
								</ol>
							</>
						</details>
					)
				}
				<article class="prose"><slot /></article>
				<slot name="after" />
			</div>
			{
				toc.length > 0 && (
					<aside class="desktop-toc" aria-label="Table of contents">
						<>
							<p class="eyebrow">On this page</p>
							<ol>
								{toc.map((h) => (
									<li class:list={[{ subheading: h.depth === 3 }]}>
										<a href={`#${h.slug}`}>{h.text}</a>
									</li>
								))}
							</ol>
						</>
					</aside>
				)
			}
		</main><Footer /></body>
</html>
