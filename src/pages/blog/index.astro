---
import Page from "../../layouts/Page.astro";
import ArticleRow from "../../components/ArticleRow.astro";
import { getCollection } from "astro:content";
const entries = (await getCollection("blog", (p) => !p.data.draft)).sort(
	(a, b) =>
		b.data.pubDate.valueOf() - a.data.pubDate.valueOf() ||
		Number(b.data.featured) - Number(a.data.featured),
);
---

<Page
	title="Engineering archive"
	description="The original engineering article archive. All existing article addresses remain available."
	><p class="eyebrow">Writing / Engineering</p><h1>Engineering archive</h1><p
		class="lede"
	>
		The original blog archive. Browse <a href="/writing/">all writing</a> for search,
		topics, and essays.
	</p><ul class="content-list">
		{entries.map((entry) => <ArticleRow entry={entry} />)}
	</ul></Page
>
