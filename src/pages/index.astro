---
import Page from "../layouts/Page.astro";
import { getCollection } from "astro:content";
import { getWriting, writingHref, readingTime } from "../utils/publication";
import DateMeta from "../components/DateMeta.astro";
import "../styles/pages/home.css";
const writing = await getWriting();
const feature = writing.find((p) => p.data.featured)!;
const projects = (await getCollection("projects")).sort(
	(a, b) => a.data.order - b.data.order,
);
const latest = writing.filter((p) => p.id !== feature.id).slice(0, 3);
---

<Page
	title="AI infrastructure & systems"
	description="Hrishikesh Agarwal's engineering publication: LLM infrastructure, inference, distributed systems, databases, and philosophy."
	wide
	home
>
	<section class="home-hero" aria-labelledby="intro-title">
		<p class="paper-label">Software engineer · Bengaluru, India</p>
		<h1 id="intro-title">
			Hi, I'm Hrishikesh.<br />I build <span class="print-blue">AI systems</span
			><br />that <em>do the work.</em>
		</h1>
		<p class="hero-intro">
			I build agents that diagnose faults, find the right information, and carry
			out tasks. Most of my work sits between <strong
				>language models and the software they need to use.</strong
			>
		</p>
		<div class="hero-links">
			<a class="paper-button primary" href="/writing/">Read my writing</a><a
				class="paper-button"
				href="/about/">A bit about me</a
			>
		</div>
	</section>
	<div class="tools-strip" aria-label="Research interests">
		<span>LLM inference</span><span>Distributed systems</span><span
			>Agentic architectures</span
		><span>Database internals</span>
	</div>
	<section class="home-section" aria-labelledby="work-title">
		<p class="section-kicker">What I work on</p><h2 id="work-title">
			From a prompt<br />to a working system.
		</h2>
		<div class="work-grid">
			<article class="work-card">
				<p class="card-label">Agents + orchestration</p><h3>
					Giving agents<br />a job to finish.
				</h3><p>
					Multi-agent workflows for predictive maintenance, conversational
					commerce, and cloud cost governance. Deciding which agent does what,
					how they share context, and when a person needs to step in.
				</p><p class="card-note">LangGraph · Tool use · Human review</p>
			</article><article class="work-card">
				<p class="card-label">Retrieval + backend</p><h3>
					Getting the right<br />context into place.
				</h3><p>
					RAG pipelines, retrieval tools, and the APIs behind them. Connecting
					models to documents and services, then making those connections work
					under production constraints.
				</p><p class="card-note">RAG · FastAPI · AWS + Azure</p>
			</article>
		</div>
	</section>
	<section
		class="home-section featured-account"
		aria-labelledby="featured-title"
	>
		<p class="section-kicker">Featured engineering account</p><h2
			id="featured-title"
		>
			<a href={writingHref(feature)}>{feature.data.title}</a>
		</h2><p>{feature.data.description}</p><p class="card-label">
			{readingTime(feature.body)} min read · Professional project · Internal product
		</p><a class="paper-button primary" href={writingHref(feature)}
			>Read the article</a
		>
	</section>
	<section class="home-section writing-section" aria-labelledby="writing-title">
		<div class="section-heading">
			<div>
				<p class="section-kicker">Notes from the work</p><h2 id="writing-title">
					Thinking in public.
				</h2>
			</div><a class="section-link" href="/writing/">All writing</a>
		</div><ul class="writing-list">
			{
				latest.map((post) => (
					<li>
						<>
							<div>
								<>
									<a href={writingHref(post)}>{post.data.title}</a>
									<p>{post.data.description}</p>
								</>
							</div>
							<DateMeta date={post.data.pubDate} as="span" />
						</>
					</li>
				))
			}
		</ul>
	</section>
	<section class="home-section" aria-labelledby="projects-title">
		<div class="section-heading">
			<div>
				<p class="section-kicker">Projects &amp; directions</p><h2
					id="projects-title"
				>
					Building. Studying.<br />Asking better questions.
				</h2>
			</div><a class="section-link" href="/projects/">Project index</a>
		</div><ul class="project-index">
			{
				projects.map((p) => (
					<li>
						<>
							<h3>
								<a href={`/projects/${p.id}/`}>{p.data.title}</a>
							</h3>
							<p>{p.data.description}</p>
							<span class="card-label">
								{p.data.kind} · {p.data.status}
							</span>
						</>
					</li>
				))
			}
		</ul>
	</section>
	<section class="home-section resources-grid">
		<div>
			<p class="section-kicker">Longer explanations</p><h2>
				Study the<br />machinery.
			</h2><p>
				A three-chapter working manuscript on inference, memory, and
				measurement, alongside annotated sources for further study.
			</p><p>
				<a href="/books/llm-inference/">Notes on LLM Inference</a> · <a
					href="/library/">Reading library</a
				>
			</p>
		</div><div>
			<p class="section-kicker">The wider notebook</p><h2>
				Beyond the<br />implementation.
			</h2><p>
				Engineering decisions and experiments in the <a href="/worklogs/"
					>worklogs</a
				>. Questions about evidence, explanation, and history in <a
					href="/philosophy/">philosophy</a
				>.
			</p>
		</div>
	</section>
	<section class="contact-section" aria-labelledby="contact-title">
		<p class="section-kicker">Compare notes</p><h2 id="contact-title">
			Let's talk<br /><span class="print-blue">shop.</span>
		</h2><p>
			Working on agents, inference, retrieval, or backend systems? I'd like to
			hear what you're building and what's proving difficult.
		</p><div class="hero-links">
			<a class="paper-button primary" href="mailto:hrishikeshagarwalv@gmail.com"
				>Email me</a
			><a
				class="paper-button"
				href="https://linkedin.com/in/hrishikesh-agarwal"
				rel="noopener noreferrer">LinkedIn</a
			><a
				class="paper-button"
				href="https://github.com/codetheorem"
				rel="noopener noreferrer">GitHub</a
			>
		</div>
	</section>
</Page>
