---
import Page from "../layouts/Page.astro";
import ArticleRow from "../components/ArticleRow.astro";
import { getCollection } from "astro:content";
import { getWriting, readingTime, writingHref } from "../utils/publication";
import "../styles/pages/home.css";
const writing = await getWriting();
const feature = writing.find((p) => p.data.featured)!;
const projects = (await getCollection("projects")).sort(
	(a, b) => a.data.order - b.data.order,
);
const latest = writing.filter((p) => p.id !== feature.id).slice(0, 3);
---

<Page
	title="AI infrastructure & systems"
	description="Hrishikesh Agarwal's engineering publication: LLM infrastructure, inference, distributed systems, databases, and philosophy."
	wide
>
	<section class="intro" aria-labelledby="intro-title">
		<div>
			<p class="eyebrow">AI infrastructure &amp; systems</p><h1
				id="intro-title"
			>
				Understanding the systems<br class="desktop-break" /> behind the abstractions.
			</h1><p class="intro-text">
				I'm Hrishikesh, a software engineer in Bengaluru. I work on AI
				infrastructure and agentic systems, and study inference, distributed
				systems, and database internals.
			</p><p class="intro-links">
				<a href="/about/">About my work</a><span aria-hidden="true">/</span><a
					href="/writing/">Explore the writing</a
				>
			</p>
		</div><aside class="margin-note">
			<p class="eyebrow">A recurring question</p><p>
				What does an abstraction cost, and which promises does it actually keep?
			</p><span>Computation · memory · state · evidence</span>
		</aside>
	</section>
	<section class="feature" aria-labelledby="feature-title">
		<div class="feature-context">
			<p class="eyebrow">Featured engineering account</p><p class="meta">
				Tokenomics<br />Professional project · Internal product
			</p>
		</div><div>
			<h2 id="feature-title">
				<a href={writingHref(feature)}>{feature.data.title}</a>
			</h2><p>{feature.data.description}</p><p class="meta">
				{readingTime(feature.body)} min read · Original diagrams · Public-safe account
			</p><a href={writingHref(feature)}>Read the article</a>
		</div>
	</section>
	<div class="home-columns">
		<section aria-labelledby="recent-title">
			<div class="section-heading">
				<h2 id="recent-title">Recent writing</h2><a href="/writing/"
					>All articles</a
				>
			</div><ul class="content-list">
				{latest.map((entry) => <ArticleRow entry={entry} />)}
			</ul>
		</section><aside class="interests" aria-labelledby="interests-title">
			<div class="section-heading">
				<h2 id="interests-title">Current research interests</h2>
			</div><dl>
				<dt>LLM inference</dt><dd>
					Execution, KV memory, batching, and the cost of generating a token.
				</dd><dt>Distributed systems</dt><dd>
					State, coordination, and the behavior of partial failures.
				</dd><dt>Agentic architectures</dt><dd>
					Tool use, context, evaluation, and the cost of completing a task.
				</dd><dt>Database internals</dt><dd>
					Query execution, storage, transactions, and recovery.
				</dd><dt>Philosophy &amp; history</dt><dd>
					Explanation, evidence, and the limits of a useful model.
				</dd>
			</dl><a href="/library/">On the reading desk</a>
		</aside>
	</div>
	<section class="home-projects" aria-labelledby="projects-title">
		<div class="section-heading">
			<h2 id="projects-title">Projects &amp; directions</h2><a href="/projects/"
				>Project index</a
			>
		</div><ul>
			{
				projects.map((p) => (
					<li>
						<>
							<h3>
								<a href={`/projects/${p.id}/`}>{p.data.title}</a>
							</h3>
							<p>{p.data.description}</p>
							<span class="meta">{p.data.kind}</span>
						</>
					</li>
				))
			}
		</ul>
	</section>
	<section class="home-bottom">
		<div>
			<p class="eyebrow">A longer reading path</p><h2>
				<a href="/books/llm-inference/">Notes on LLM Inference</a>
			</h2><p>
				A working manuscript on execution, memory, and measurement. Three
				chapters to start with.
			</p><a href="/books/llm-inference/">Open the manuscript</a>
		</div><div>
			<p class="eyebrow">From the notebook</p><h2>
				<a href="/worklogs/">Work in progress</a>
			</h2><p>
				Experiments and engineering decisions, kept separate from finished
				explanations.
			</p><a href="/worklogs/">Read the worklogs</a>
		</div>
	</section>
</Page>
