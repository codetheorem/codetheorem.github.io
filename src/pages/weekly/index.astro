---
import Page from "../../layouts/Page.astro";
import { getCollection } from "astro:content";
import { getWeeklyHref, formatWeeklyTitle } from "../../utils/weekly";
const entries = (await getCollection("weekly", (p) => !p.data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Page
	title="Weekly archive"
	description="The original weekly learning and engineering notes."
	><p class="eyebrow">Worklogs / Archive</p><h1>Weekly notes</h1><p
		class="lede"
	>
		The original notebook archive. Find newer experiments and engineering notes
		under <a href="/worklogs/">worklogs</a>.
	</p><ul class="content-list">
		{
			entries.map((e) => (
				<li>
					<>
						<h2>
							<a href={getWeeklyHref(e.data)}>{formatWeeklyTitle(e.data)}</a>
						</h2>
						<p>{e.data.description}</p>
						<span class="meta">{e.data.dateRange}</span>
					</>
				</li>
			))
		}
	</ul></Page
>
