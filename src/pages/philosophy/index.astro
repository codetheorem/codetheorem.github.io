---
import Page from "../../layouts/Page.astro";
import ArticleRow from "../../components/ArticleRow.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("philosophy", (p) => !p.data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Page
	title="Philosophy"
	description="Essays on explanation, evidence, historical interpretation, and technical understanding."
	><p class="eyebrow">Beyond the implementation</p><h1>
		Philosophy &amp; history
	</h1><p class="lede">
		Questions about explanation, evidence, and the categories through which we
		understand things. Essays that leave room for uncertainty.
	</p><ul class="content-list">
		{posts.map((entry) => <ArticleRow entry={entry} />)}
	</ul></Page
>
