---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { readingTime } from "../../utils/publication";
export async function getStaticPaths() {
	const [books, chapters] = await Promise.all([
		getCollection("books"),
		getCollection("chapters", (p) => !p.data.draft),
	]);
	return [
		...books.map((entry) => ({
			params: { slug: entry.id },
			props: { entry, isChapter: false, bookId: entry.id },
		})),
		...chapters.map((entry) => ({
			params: { slug: entry.id },
			props: { entry, isChapter: true, bookId: entry.data.book },
		})),
	];
}
const { entry, isChapter, bookId } = Astro.props;
const chapters = (
	await getCollection(
		"chapters",
		(p) => !p.data.draft && p.data.book === bookId,
	)
).sort((a, b) => a.data.order - b.data.order);
const book = (await getCollection("books")).find((b) => b.id === bookId)!;
const index = chapters.findIndex((c) => c.id === entry.id);
const previous = chapters[index - 1];
const next = chapters[index + 1];
const { Content, headings } = await render(entry);
---

<Layout
	title={entry.data.title}
	description={entry.data.description}
	pubDate={entry.data.pubDate}
	updatedDate={entry.data.updatedDate}
	headings={headings}
	minutes={readingTime(entry.body)}
	category={isChapter ? book.data.title : "Working manuscript"}
	section={{
		href: isChapter ? `/books/${bookId}/` : "/books/",
		label: isChapter ? "Book contents" : "Books",
	}}
>
	<Content />
	<div slot="after" class="article-after">
		<nav aria-label="Book chapters">
			<h2>{isChapter ? "In this book" : "Contents"}</h2><ol>
				{
					chapters.map((c) => (
						<li>
							<a
								href={`/books/${c.id}/`}
								aria-current={entry.id === c.id ? "page" : undefined}
							>
								{c.data.title}
							</a>
						</li>
					))
				}
			</ol>
			{
				isChapter && (
					<div class="chapter-pager">
						{previous && (
							<a href={`/books/${previous.id}/`}>
								Previous: {previous.data.title}
							</a>
						)}
						{next && <a href={`/books/${next.id}/`}>Next: {next.data.title}</a>}
					</div>
				)
			}
		</nav>
	</div>
</Layout>
<style>
	.chapter-pager {
		display: grid;
		gap: 1rem;
		border-top: 1px solid var(--border-color);
		padding-top: 1rem;
		font-size: 0.9rem;
	}
</style>
