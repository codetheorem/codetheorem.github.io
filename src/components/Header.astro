---
import HeaderLink from "./HeaderLink.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import { NAV_LINKS } from "../data/navigation";

interface Props {
	breadcrumbTitle?: string;
}
const { breadcrumbTitle } = Astro.props;
const isHomePage = Astro.url.pathname === "/";
---

<header data-site-header>
	<nav class="site-nav" aria-label="Primary navigation">
		<a class="brand" href="/" aria-label="Hrishikesh Agarwal home"
			>hrishikesh<span>.</span>agarwal</a
		>
		<div class="nav-links">
			{
				NAV_LINKS.map((link) => (
					<HeaderLink href={link.href}>{link.label}</HeaderLink>
				))
			}
		</div>
		<ThemeToggle />
	</nav>
	{
		!isHomePage && (
			<div class="breadcrumb-row">
				<Breadcrumbs customTitle={breadcrumbTitle} />
			</div>
		)
	}
</header>
<style>
	header {
		padding: 0 1.25rem;
	}
	.site-nav {
		max-width: 1040px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		gap: 1.5rem;
		padding: 1.4rem 0;
		border-bottom: 1px solid var(--text-color);
	}
	.brand {
		font: 700 0.875rem/1.5 var(--font-family-code);
		text-decoration: none;
		white-space: nowrap;
	}
	.brand span {
		color: var(--accent-blue);
	}
	.nav-links {
		display: flex;
		gap: 1.4rem;
		flex-wrap: wrap;
		margin-left: auto;
		font: 400 0.875rem/1.5 var(--font-family-code);
	}
	.breadcrumb-row {
		max-width: 760px;
		margin: 1.25rem auto 0;
		font: 400 0.8rem/1.6 var(--font-family-code);
	}
	@media (max-width: 720px) {
		.site-nav {
			flex-wrap: wrap;
			gap: 1rem;
		}
		.nav-links {
			order: 3;
			width: 100%;
			margin: 0;
			gap: 1.5rem;
		}
		.site-nav :global(.theme-toggle) {
			margin-left: auto;
		}
	}
	@media (max-width: 380px) {
		.nav-links {
			gap: 1rem;
			font-size: 0.8rem;
		}
		.brand {
			font-size: 0.8rem;
		}
	}
</style>
