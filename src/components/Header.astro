---
import ThemeToggle from "./ThemeToggle.astro";
import { NAV_LINKS } from "../data/navigation";
interface Props {
	breadcrumbTitle?: string;
}
const current = Astro.url.pathname;
const active = (href: string) =>
	current.startsWith(href) ||
	(href === "/writing/" && current.startsWith("/blog/")) ||
	(href === "/worklogs/" && current.startsWith("/weekly/"));
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
	<div class="masthead">
		<a href="/" class="brand"
			>Hrishikesh Agarwal<span>Engineering &amp; inquiry</span></a
		>
		<div class="header-tools">
			<a href="/writing/#search" aria-label="Search the publication">Search</a
			><ThemeToggle />
		</div>
	</div>
	<nav aria-label="Main navigation">
		{
			NAV_LINKS.map((link) => (
				<a
					href={link.href}
					aria-current={active(link.href) ? "page" : undefined}
				>
					{link.label}
				</a>
			))
		}
	</nav>
</header>
<style>
	.site-header {
		width: min(100% - 3rem, 1080px);
		margin: 0 auto;
		padding: 1.8rem 0 0;
	}
	.masthead {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding-bottom: 1.5rem;
	}
	.brand {
		font: 400 1.4rem/1.2 var(--font-family-heading);
		color: var(--text-color);
		text-decoration: none;
	}
	.brand span {
		display: block;
		font: 400 0.73rem/1.6 var(--font-family-base);
		letter-spacing: 0.04em;
		color: var(--text-color-muted);
		margin-top: 0.4rem;
	}
	.header-tools {
		display: flex;
		align-items: center;
		gap: 1rem;
		font-size: 0.875rem;
	}
	.header-tools > a {
		color: var(--text-color-muted);
		text-decoration: none;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.7rem;
		border-top: 1px solid var(--border-color);
		border-bottom: 1px solid var(--border-color);
		padding: 0.9rem 0;
	}
	nav a {
		font-size: 0.875rem;
		color: var(--text-color-light);
		text-decoration: none;
	}
	nav a:hover,
	nav a[aria-current] {
		color: var(--text-color);
		text-decoration: underline;
		text-underline-offset: 0.35em;
	}
	@media (max-width: 600px) {
		.site-header {
			width: calc(100% - 2.5rem);
			padding-top: 1.25rem;
		}
		nav {
			gap: 0.65rem 1.15rem;
		}
		.brand {
			font-size: 1.2rem;
		}
		.header-tools {
			gap: 0.4rem;
		}
	}
</style>
