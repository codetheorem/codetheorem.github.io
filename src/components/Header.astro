---
import ThemeToggle from "./ThemeToggle.astro";
import { NAV_LINKS } from "../data/navigation";
interface Props {
	breadcrumbTitle?: string;
}
const current = Astro.url.pathname;
const active = (href: string) =>
	current.startsWith(href) ||
	(href === "/writing/" && current.startsWith("/blog/")) ||
	(href === "/worklogs/" && current.startsWith("/weekly/"));
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
	<a href="/" class="brand" aria-label="Hrishikesh Agarwal home"
		>hrishikesh<span>.</span>agarwal</a
	>
	<nav aria-label="Main navigation">
		{
			NAV_LINKS.map((link) => (
				<a
					href={link.href}
					aria-current={active(link.href) ? "page" : undefined}
				>
					{link.label}
				</a>
			))
		}
	</nav>
	<div class="header-tools">
		<a href="/writing/#search">Search</a><ThemeToggle />
	</div>
</header>
<style>
	.site-header {
		width: min(100% - 2.5rem, 1040px);
		margin: 0 auto;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem 1.75rem;
		padding: 1.4rem 0;
		border-bottom: 1px solid var(--text-color);
	}
	.brand {
		font: 700 0.875rem/1.5 var(--font-family-code);
		color: var(--text-color);
		text-decoration: none;
		white-space: nowrap;
	}
	.brand span {
		color: var(--accent-blue);
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem 1.15rem;
		margin-left: auto;
	}
	nav a,
	.header-tools > a {
		font: 400 0.875rem/1.5 var(--font-family-code);
		color: var(--text-color);
		text-decoration: none;
	}
	nav a:hover,
	nav a[aria-current] {
		color: var(--accent-blue);
		text-decoration: underline;
		text-decoration-color: var(--accent-pink);
		text-underline-offset: 0.3em;
	}
	.header-tools {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.header-tools > a {
		font-size: 0.8rem;
	}
	@media (max-width: 1000px) {
		nav {
			order: 3;
			flex-basis: 100%;
			margin: 0;
		}
		.header-tools {
			margin-left: auto;
		}
	}
	@media (max-width: 400px) {
		.brand {
			font-size: 0.78rem;
		}
		nav {
			gap: 0.7rem 1rem;
		}
		nav a {
			font-size: 0.8rem;
		}
	}
</style>
